    },
    {
      "trigger": "main",
      "insert": "public static void main(String[] args) {\n    $0\n}",
      "detail": "main method"
    },
    {
      "trigger": "psvm",
      "insert": "public static void main(String[] args) {\n    $0\n}",
      "detail": "main method"
    },
    {
      "trigger": "trycatch",
      "insert": "try {\n    $0\n} catch (Exception e) {\n}",
      "detail": "try/catch"
    },
    {
      "trigger": "ifn",
      "insert": "if ($0 == null) {\n}",
      "detail": "if null"
    }
  ],
  "lineComment": "//",
  "blockComment": ["/*", "*/"],
  "textBlock": ["\"\"\"", "\"\"\""],
  "doubleQuotedStrings": true,
  "singleQuotedChars": true,
  "singleQuotedStrings": false,
  "operatorChars": "+-*/%=<>!&|^~?:",
